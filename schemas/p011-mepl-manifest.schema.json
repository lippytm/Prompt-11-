{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lippytm.ai/schemas/p011-mepl-manifest.schema.json",
  "title": "Prompt #11 Master Evidence and Product Ledger Manifest",
  "description": "Machine-readable manifest for a Master Evidence and Product Ledger implementation, version, or release candidate.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "ledger_id",
    "ledger_version",
    "title",
    "status",
    "implementation_type",
    "privacy_profile",
    "canonical_references",
    "current_checkpoint",
    "model_lines",
    "workbook",
    "required_tables",
    "quality",
    "completion_boundary"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "0.1.0"
    },
    "ledger_id": {
      "type": "string",
      "pattern": "^PROD-P011-MEPL-[A-Z0-9-]+$"
    },
    "ledger_version": {
      "type": "string",
      "pattern": "^v[0-9]+(\\.[0-9]+){1,2}$"
    },
    "title": {
      "type": "string",
      "minLength": 10,
      "maxLength": 240
    },
    "status": {
      "type": "string",
      "enum": [
        "architecture",
        "building",
        "under_review",
        "q3_testable_pilot",
        "q4_certified_product",
        "production_proven",
        "franchise_replicable",
        "continuum_stewarded",
        "quarantined",
        "superseded",
        "retired"
      ]
    },
    "implementation_type": {
      "type": "string",
      "enum": ["xlsx", "csv_bundle", "sqlite", "postgresql", "airtable", "other"]
    },
    "created_at": {
      "type": ["string", "null"],
      "format": "date-time"
    },
    "updated_at": {
      "type": ["string", "null"],
      "format": "date-time"
    },
    "human_owner": {
      "type": ["string", "null"]
    },
    "privacy_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["highest_data_class", "restricted_data_included", "public_export_enabled"],
      "properties": {
        "highest_data_class": {
          "type": "string",
          "enum": ["public", "internal", "confidential", "restricted"]
        },
        "restricted_data_included": {
          "type": "boolean"
        },
        "public_export_enabled": {
          "type": "boolean"
        },
        "redaction_required": {
          "type": "boolean"
        },
        "notes": {
          "type": ["string", "null"]
        }
      }
    },
    "canonical_references": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "data_model_document", "data_model_contract", "manifest_schema"],
      "properties": {
        "repository": {"type": "string", "minLength": 3},
        "branch_or_tag": {"type": ["string", "null"]},
        "commit_sha": {"type": ["string", "null"]},
        "data_model_document": {"type": "string", "minLength": 3},
        "data_model_contract": {"type": "string", "minLength": 3},
        "manifest_schema": {"type": "string", "minLength": 3},
        "continuation_packet": {"type": ["string", "null"]},
        "issue_reference": {"type": ["string", "integer", "null"]},
        "pull_request_reference": {"type": ["string", "integer", "null"]}
      }
    },
    "current_checkpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["packet_id", "packet_version", "status", "highest_priority_action", "risk_gate", "certification_level", "human_approval_status"],
      "properties": {
        "packet_id": {"type": "string", "minLength": 3},
        "packet_version": {"type": "string", "minLength": 2},
        "status": {
          "type": "string",
          "enum": ["draft", "under_review", "approved", "superseded", "quarantined", "retired"]
        },
        "highest_priority_action": {"type": "string", "minLength": 5},
        "parallel_human_action": {"type": ["string", "null"]},
        "risk_gate": {
          "type": "string",
          "enum": ["green", "yellow", "orange", "red"]
        },
        "certification_level": {
          "type": "string",
          "enum": ["Q0", "Q1", "Q2", "Q3", "Q4", "Q5", "Q6", "Q7"]
        },
        "human_approval_status": {
          "type": "string",
          "enum": ["not_requested", "pending", "approved", "rejected", "expired", "revoked"]
        }
      }
    },
    "model_lines": {
      "type": "object",
      "additionalProperties": false,
      "required": ["chatgpt_business", "gemini_notebooklm", "claude_fabric_hermes", "comparison", "merged_premium"],
      "properties": {
        "chatgpt_business": {"$ref": "#/$defs/model_line"},
        "gemini_notebooklm": {"$ref": "#/$defs/model_line"},
        "claude_fabric_hermes": {"$ref": "#/$defs/model_line"},
        "human_editorial": {"$ref": "#/$defs/model_line"},
        "comparison": {"$ref": "#/$defs/model_line"},
        "merged_premium": {"$ref": "#/$defs/model_line"}
      }
    },
    "workbook": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file_name", "sheet_count", "sheets", "mobile_views", "formula_engine", "validation_enabled", "version_history_enabled"],
      "properties": {
        "file_name": {"type": "string", "minLength": 5},
        "file_hash": {"type": ["string", "null"]},
        "sheet_count": {"type": "integer", "minimum": 1},
        "sheets": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "purpose", "implemented"],
            "properties": {
              "name": {"type": "string", "minLength": 1, "maxLength": 31},
              "purpose": {"type": "string", "minLength": 3},
              "implemented": {"type": "boolean"},
              "table_names": {
                "type": "array",
                "items": {"type": "string"}
              }
            }
          }
        },
        "mobile_views": {
          "type": "array",
          "items": {"type": "string"}
        },
        "formula_engine": {
          "type": "string",
          "enum": ["excel", "libreoffice", "database", "none", "other"]
        },
        "validation_enabled": {"type": "boolean"},
        "conditional_formatting_enabled": {"type": "boolean"},
        "version_history_enabled": {"type": "boolean"},
        "public_export_formats": {
          "type": "array",
          "items": {"type": "string", "enum": ["xlsx", "csv", "json", "pdf", "none"]}
        }
      }
    },
    "required_tables": {
      "type": "array",
      "minItems": 20,
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "sample_records": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["table", "record_id", "synthetic_or_public"],
        "properties": {
          "table": {"type": "string", "minLength": 1},
          "record_id": {"type": "string", "minLength": 1},
          "synthetic_or_public": {"type": "boolean"},
          "description": {"type": ["string", "null"]}
        }
      }
    },
    "exports": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["export_type", "enabled", "privacy_check_required", "approval_required"],
        "properties": {
          "export_type": {"type": "string", "minLength": 2},
          "enabled": {"type": "boolean"},
          "privacy_check_required": {"type": "boolean"},
          "rights_check_required": {"type": "boolean"},
          "approval_required": {"type": "boolean"},
          "destination": {"type": ["string", "null"]}
        }
      }
    },
    "quality": {
      "type": "object",
      "additionalProperties": false,
      "required": ["certification_target", "certification_level", "risk_gate", "critical_gates_pass", "open_critical_defects", "human_approval_status", "decision"],
      "properties": {
        "certification_target": {
          "type": "string",
          "enum": ["Q0", "Q1", "Q2", "Q3", "Q4", "Q5", "Q6", "Q7"]
        },
        "certification_level": {
          "type": "string",
          "enum": ["Q0", "Q1", "Q2", "Q3", "Q4", "Q5", "Q6", "Q7"]
        },
        "risk_gate": {
          "type": "string",
          "enum": ["green", "yellow", "orange", "red"]
        },
        "quality_score": {
          "type": ["number", "null"],
          "minimum": 0,
          "maximum": 100
        },
        "critical_gates_pass": {"type": "boolean"},
        "open_critical_defects": {"type": "integer", "minimum": 0},
        "tests_completed": {
          "type": "array",
          "items": {"type": "string"}
        },
        "known_limitations": {
          "type": "array",
          "items": {"type": "string"}
        },
        "human_approval_status": {
          "type": "string",
          "enum": ["not_requested", "pending", "approved", "rejected", "expired", "revoked"]
        },
        "decision": {
          "type": "string",
          "enum": ["not_evaluated", "continue_building", "conditional_pilot", "q3_approved", "q4_approved", "quarantine", "reject", "retire"]
        }
      }
    },
    "completion_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["implemented", "not_implemented"],
      "properties": {
        "implemented": {
          "type": "array",
          "items": {"type": "string"}
        },
        "not_implemented": {
          "type": "array",
          "items": {"type": "string"}
        }
      }
    }
  },
  "$defs": {
    "model_line": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "status", "independent_first_pass", "comparison_eligible"],
      "properties": {
        "required": {"type": "boolean"},
        "status": {
          "type": "string",
          "enum": ["not_started", "researching", "drafting", "qa", "approved", "rejected", "superseded", "not_applicable"]
        },
        "edition_id": {"type": ["string", "null"]},
        "independent_first_pass": {"type": "boolean"},
        "source_manifest": {"type": ["string", "null"]},
        "quality_packet": {"type": ["string", "null"]},
        "comparison_eligible": {"type": "boolean"},
        "merged_premium_eligible": {"type": "boolean"}
      }
    }
  }
}
