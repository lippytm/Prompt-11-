{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lippytm.ai/schemas/p011-xpio-identity-passport.schema.json",
  "title": "Prompt 11 XPIO Identity Passport",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "identity_id",
    "identity_type",
    "display_name",
    "human_owner",
    "disclosure",
    "permitted_roles",
    "permitted_memory_classes",
    "prohibited_actions",
    "platform_scope",
    "status",
    "human_approver"
  ],
  "properties": {
    "identity_id": {"type": "string", "pattern": "^(HUMAN|BRAND|CLONE|CHAR|AGENT|SWARM)-[A-Z0-9-]+$"},
    "identity_type": {"enum": ["real_human", "business_brand", "ai_clone_interface", "fictional_character", "agent", "swarm"]},
    "display_name": {"type": "string", "minLength": 2},
    "human_owner": {"type": "string", "minLength": 3},
    "disclosure": {"type": "string", "minLength": 10},
    "permitted_roles": {"type": "array", "items": {"type": "string"}},
    "permitted_memory_classes": {"type": "array", "items": {"enum": ["verified_personal", "project_record", "public_research", "reported_unverified", "fictional"]}},
    "prohibited_actions": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "platform_scope": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "budget_limit_usd": {"type": ["number", "null"], "minimum": 0},
    "timeout_seconds": {"type": ["integer", "null"], "minimum": 1},
    "version": {"type": "string"},
    "parent_identity_id": {"type": ["string", "null"]},
    "expires_at": {"type": ["string", "null"], "format": "date-time"},
    "status": {"enum": ["draft", "sandbox", "pilot", "active", "suspended", "revoked", "retired"]},
    "human_approver": {"type": "string", "minLength": 3},
    "revocation_method": {"type": ["string", "null"]}
  }
}
