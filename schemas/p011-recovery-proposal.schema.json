{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://github.com/lippytm/Prompt-11-/schemas/p011-recovery-proposal.schema.json",
  "title":"Prompt #11 Recovery Proposal",
  "type":"object",
  "additionalProperties":false,
  "required":[
    "proposal_id","incident_id","target","target_ref","state",
    "root_cause_hypothesis","change_summary","permitted_scope","rollback_target",
    "tests","regression_tests","evidence","known_risks","unresolved_gaps",
    "human_approval","production_mutation_allowed"
  ],
  "properties":{
    "proposal_id":{"type":"string","minLength":1},
    "incident_id":{"type":"string","minLength":1},
    "target":{"type":"string","minLength":1},
    "target_ref":{"type":"string","minLength":1},
    "state":{"type":"string","enum":["DRAFT","TESTABLE","TESTED","REVIEW_READY","APPROVED","REJECTED","QUARANTINED"]},
    "root_cause_hypothesis":{"type":"string","minLength":1},
    "change_summary":{"type":"string","minLength":1},
    "permitted_scope":{"type":"string","minLength":1},
    "rollback_target":{"type":"string","minLength":1},
    "tests":{"type":"array","minItems":1,"items":{"type":"string","minLength":1}},
    "regression_tests":{"type":"array","minItems":1,"items":{"type":"string","minLength":1}},
    "evidence":{"type":"array","items":{"type":"string","minLength":1}},
    "known_risks":{"type":"array","items":{"type":"string"}},
    "unresolved_gaps":{"type":"array","items":{"type":"string"}},
    "human_approval":{
      "type":"object","additionalProperties":false,
      "required":["required","approved"],
      "properties":{
        "required":{"const":true},
        "approved":{"type":"boolean"},
        "approver":{"type":["string","null"]},
        "audit_reference":{"type":["string","null"]}
      }
    },
    "production_mutation_allowed":{"const":false}
  },
  "allOf":[
    {
      "if":{"properties":{"state":{"const":"APPROVED"}},"required":["state"]},
      "then":{
        "properties":{
          "human_approval":{
            "properties":{
              "approved":{"const":true},
              "approver":{"type":"string","minLength":1},
              "audit_reference":{"type":"string","minLength":1}
            },
            "required":["approver","audit_reference"]
          }
        }
      }
    }
  ]
}
