{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lippytm.ai/schemas/p011-eesi-clone-passport.schema.json",
  "title": "Prompt #11 EESI Clone Passport",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "clone_id",
    "display_name",
    "legal_owner",
    "identity_class",
    "model_line",
    "version",
    "status",
    "permitted_actions",
    "prohibited_actions",
    "permitted_privacy_classes",
    "human_approval_required"
  ],
  "properties": {
    "clone_id": {"type": "string", "pattern": "^CLONE-[A-Z0-9-]+$"},
    "display_name": {"type": "string", "minLength": 3},
    "legal_owner": {"type": "string", "minLength": 3},
    "identity_class": {
      "enum": ["authorized_ai_interface", "fictional_interface", "business_interface", "research_sandbox"]
    },
    "model_line": {
      "enum": ["chatgpt", "gemini_notebooklm", "claude_hermes", "comparison", "merged_premium", "provider_neutral"]
    },
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "status": {
      "enum": ["proposed", "sandbox", "pilot", "production", "suspended", "revoked", "retired"]
    },
    "parent_clone_id": {"type": ["string", "null"]},
    "permitted_actions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 3}
    },
    "prohibited_actions": {
      "type": "array",
      "minItems": 5,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 3},
      "allOf": [
        {"contains": {"const": "impersonate_legal_person"}},
        {"contains": {"const": "fabricate_personal_memory"}},
        {"contains": {"const": "autonomous_financial_action"}},
        {"contains": {"const": "autonomous_contracting"}},
        {"contains": {"const": "bypass_human_approval"}}
      ]
    },
    "permitted_privacy_classes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"enum": ["public", "internal", "confidential", "restricted"]}
    },
    "human_approval_required": {"const": true}
  }
}
