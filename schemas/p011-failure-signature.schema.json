{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://github.com/lippytm/Prompt-11-/schemas/p011-failure-signature.schema.json",
  "title":"Prompt #11 Failure Signature",
  "type":"object",
  "additionalProperties":false,
  "required":[
    "signature_id","error_class","component","trigger_condition",
    "observed_behavior","expected_behavior","evidence_refs",
    "recurrence_count","root_cause_hypotheses","prior_repairs",
    "regression_tests","review_state"
  ],
  "properties":{
    "signature_id":{"type":"string","minLength":1},
    "error_class":{"type":"string","minLength":1},
    "component":{"type":"string","minLength":1},
    "trigger_condition":{"type":"string","minLength":1},
    "observed_behavior":{"type":"string","minLength":1},
    "expected_behavior":{"type":"string","minLength":1},
    "evidence_refs":{"type":"array","items":{"type":"string","minLength":1}},
    "recurrence_count":{"type":"integer","minimum":1},
    "root_cause_hypotheses":{
      "type":"array","minItems":1,
      "items":{
        "type":"object","additionalProperties":false,
        "required":["hypothesis_id","summary","evidence_refs","contradiction_count","status"],
        "properties":{
          "hypothesis_id":{"type":"string","minLength":1},
          "summary":{"type":"string","minLength":1},
          "evidence_refs":{"type":"array","items":{"type":"string","minLength":1}},
          "contradiction_count":{"type":"integer","minimum":0},
          "status":{"type":"string","enum":["OPEN","SUPPORTED","CONTRADICTED","REJECTED"]}
        }
      }
    },
    "prior_repairs":{"type":"array","items":{"type":"string"}},
    "regression_tests":{"type":"array","items":{"type":"string","minLength":1}},
    "review_state":{"type":"string","enum":["DRAFT","REVIEWED","SUPERSEDED"]}
  }
}
