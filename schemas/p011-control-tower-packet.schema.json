{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://github.com/lippytm/Prompt-11-/schemas/p011-control-tower-packet.schema.json",
  "title":"Prompt #11 AI Control Tower Packet",
  "type":"object",
  "additionalProperties":false,
  "required":[
    "packet_id","version","work_packet_id","prompt_modules","sandbox_status",
    "critical_gates","best_practice","risks","regressions","evidence_completeness",
    "rollback_ready","human_approval"
  ],
  "properties":{
    "packet_id":{"type":"string","minLength":1},
    "version":{"type":"string","pattern":"^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "work_packet_id":{"type":"string","minLength":1},
    "prompt_modules":{
      "type":"array","minItems":1,
      "items":{
        "type":"object","additionalProperties":false,
        "required":["module_id","version"],
        "properties":{
          "module_id":{"type":"string","minLength":1},
          "version":{"type":"string","pattern":"^[0-9]+\\.[0-9]+\\.[0-9]+$"}
        }
      }
    },
    "sandbox_status":{
      "type":"object","additionalProperties":false,
      "required":["IF","MAYBE","WHY_NOT","DONT_DO_THAT","I_TOLD_YOU_NOT_TO_DO_THAT"],
      "properties":{
        "IF":{"type":"string","enum":["not_run","pass","partial","fail"]},
        "MAYBE":{"type":"string","enum":["not_run","pass","partial","fail"]},
        "WHY_NOT":{"type":"string","enum":["not_run","pass","partial","fail"]},
        "DONT_DO_THAT":{"type":"string","enum":["not_run","pass","partial","fail"]},
        "I_TOLD_YOU_NOT_TO_DO_THAT":{"type":"string","enum":["not_applicable","not_run","pass","partial","fail"]}
      }
    },
    "critical_gates":{
      "type":"object","additionalProperties":{"type":"boolean"},
      "minProperties":1
    },
    "best_practice":{
      "type":"object","additionalProperties":false,
      "required":["score","promotion_blocked"],
      "properties":{
        "score":{"type":"integer","minimum":0,"maximum":100},
        "promotion_blocked":{"type":"boolean"}
      }
    },
    "risks":{
      "type":"array",
      "items":{
        "type":"object","additionalProperties":false,
        "required":["severity","description","resolved"],
        "properties":{
          "severity":{"type":"string","enum":["low","medium","high","critical"]},
          "description":{"type":"string","minLength":1},
          "resolved":{"type":"boolean"}
        }
      }
    },
    "regressions":{
      "type":"array",
      "items":{
        "type":"object","additionalProperties":false,
        "required":["severity","test_id","passed"],
        "properties":{
          "severity":{"type":"string","enum":["low","medium","high","critical"]},
          "test_id":{"type":"string","minLength":1},
          "passed":{"type":"boolean"}
        }
      }
    },
    "evidence_completeness":{"type":"integer","minimum":0,"maximum":100},
    "model_disagreements":{"type":"array","items":{"type":"string"}},
    "rollback_ready":{"type":"boolean"},
    "recommended_next_action":{"type":["string","null"]},
    "human_approval":{
      "type":"object","additionalProperties":false,
      "required":["required","approved"],
      "properties":{
        "required":{"const":true},
        "approved":{"type":"boolean"},
        "approver":{"type":["string","null"]},
        "audit_reference":{"type":["string","null"]}
      }
    }
  }
}
