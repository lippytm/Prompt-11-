{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://github.com/lippytm/Prompt-11-/schemas/p011-best-practice-attestation.schema.json",
  "title":"Prompt #11 Best Practice Attestation",
  "type":"object",
  "additionalProperties":false,
  "required":["attestation_id","work_packet_id","risk_level","applicable_domains","evidence","critical_gates","unresolved_deviations","production_activation","human_approval"],
  "properties":{
    "attestation_id":{"type":"string","minLength":1},
    "work_packet_id":{"type":"string","minLength":1},
    "risk_level":{"type":"string","enum":["low","medium","high","critical"]},
    "applicable_domains":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","minLength":1}},
    "non_applicable_domains":{"type":"array","items":{"type":"object","required":["domain","rationale"],"additionalProperties":false,"properties":{"domain":{"type":"string","minLength":1},"rationale":{"type":"string","minLength":1}}}},
    "evidence":{"type":"array","items":{"type":"string"}},
    "tests":{"type":"array","items":{"type":"string"}},
    "critical_gates":{
      "type":"object",
      "additionalProperties":false,
      "required":["authority","privacy_security","evidence_provenance","testing","risk","rollback_recovery"],
      "properties":{
        "authority":{"type":"boolean"},
        "privacy_security":{"type":"boolean"},
        "evidence_provenance":{"type":"boolean"},
        "testing":{"type":"boolean"},
        "risk":{"type":"boolean"},
        "rollback_recovery":{"type":"boolean"}
      }
    },
    "unresolved_deviations":{"type":"array","items":{"type":"string"}},
    "production_activation":{"const":false},
    "human_approval":{
      "type":"object","additionalProperties":false,
      "required":["required","approved"],
      "properties":{
        "required":{"const":true},
        "approved":{"type":"boolean"},
        "approver":{"type":["string","null"]},
        "audit_reference":{"type":["string","null"]}
      }
    }
  },
  "allOf":[
    {
      "if":{"properties":{"human_approval":{"properties":{"approved":{"const":true}},"required":["approved"]}},"required":["human_approval"]},
      "then":{"properties":{"human_approval":{"properties":{"approver":{"type":"string","minLength":1},"audit_reference":{"type":"string","minLength":1}},"required":["approver","audit_reference"]}}}
    }
  ]
}
