{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://github.com/lippytm/Prompt-11-/schemas/p011-canary-telemetry.schema.json",
  "title":"Prompt #11 Canary Telemetry",
  "type":"object",
  "additionalProperties":false,
  "required":["telemetry_id","canary_id","baseline","candidate","production_activation"],
  "properties":{
    "telemetry_id":{"type":"string","minLength":1},
    "canary_id":{"type":"string","minLength":1},
    "baseline":{"$ref":"#/$defs/metrics"},
    "candidate":{"$ref":"#/$defs/metrics"},
    "production_activation":{"const":false}
  },
  "$defs":{
    "metrics":{
      "type":"object",
      "additionalProperties":false,
      "required":[
        "sample_count","success_rate","failure_rate","critical_error_count",
        "high_severity_regression_count","evidence_completeness",
        "output_schema_pass_rate","latency_ms"
      ],
      "properties":{
        "sample_count":{"type":"integer","minimum":1},
        "success_rate":{"type":"number","minimum":0,"maximum":100},
        "failure_rate":{"type":"number","minimum":0,"maximum":100},
        "critical_error_count":{"type":"integer","minimum":0},
        "high_severity_regression_count":{"type":"integer","minimum":0},
        "evidence_completeness":{"type":"number","minimum":0,"maximum":100},
        "output_schema_pass_rate":{"type":"number","minimum":0,"maximum":100},
        "latency_ms":{"type":"number","minimum":0},
        "retry_count":{"type":"integer","minimum":0},
        "tool_call_count":{"type":"integer","minimum":0},
        "estimated_cost":{"type":["number","null"],"minimum":0}
      }
    }
  }
}
