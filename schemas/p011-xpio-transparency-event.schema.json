{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lippytm.ai/schemas/p011-xpio-transparency-event.schema.json",
  "title": "Prompt 11 XPIO Transparency Event",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_id",
    "correlation_id",
    "timestamp",
    "actor_type",
    "actor_id",
    "event_type",
    "object_type",
    "object_id",
    "severity",
    "result",
    "summary"
  ],
  "properties": {
    "event_id": {"type": "string", "pattern": "^EVT-XPIO-[0-9]{6,}$"},
    "correlation_id": {"type": "string", "minLength": 8},
    "timestamp": {"type": "string", "format": "date-time"},
    "actor_type": {"enum": ["human", "ai_model", "agent", "swarm", "platform", "system"]},
    "actor_id": {"type": "string", "minLength": 2},
    "platform_id": {"type": ["string", "null"]},
    "model_line": {"type": ["string", "null"]},
    "event_type": {"type": "string", "minLength": 3},
    "object_type": {"type": "string", "minLength": 2},
    "object_id": {"type": "string", "minLength": 2},
    "severity": {"enum": ["INFO", "WARN", "ERROR", "CRITICAL"]},
    "result": {"enum": ["SUCCESS", "FAILURE", "BLOCKED", "PENDING", "NOT_TESTED"]},
    "summary": {"type": "string", "minLength": 3},
    "rationale_summary": {"type": ["string", "null"]},
    "input_artifact_ids": {"type": "array", "items": {"type": "string"}},
    "output_artifact_ids": {"type": "array", "items": {"type": "string"}},
    "evidence_reference": {"type": ["string", "null"]},
    "gate_status": {"type": ["string", "null"]},
    "human_approval_status": {"type": ["string", "null"]},
    "duration_ms": {"type": ["integer", "null"], "minimum": 0},
    "cost_usd": {"type": ["number", "null"], "minimum": 0},
    "correction_reference": {"type": ["string", "null"]},
    "details": {"type": "object"}
  }
}
